<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/delete_account_explanation" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:hint="@string/delete_account_confirmation">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/deleteConfirmation"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textNoSuggestions" android:maxLines="1" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/clearGuestData"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/delete_guest_data_choice" />
</LinearLayout>
